# Active pipeline combo — switch without restarting the server
MAWRID_COMBO=H1G

# ── Internal DB ──────────────────────────────────────────────────────────────
# Dev: SQLite (default)
DATABASE_URL=sqlite+aiosqlite:///./mawrid.db
# Prod: swap to PostgreSQL with one line change
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/mawrid

# ── Infrastructure ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
MLFLOW_TRACKING_URI=http://mlflow:5000

# ── Azure Document Intelligence ──────────────────────────────────────────────
AZURE_DI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_DI_KEY=<your-key>
AZURE_DI_CLASSIFIER_MODEL_ID=mawrid-classifier-v1
AZURE_DI_EXTRACTOR_MODEL_ID=mawrid-extractor-v1

# ── Frontier LLM API keys (used by LiteLLM) ──────────────────────────────────
GEMINI_API_KEY=<your-gemini-key>
ANTHROPIC_API_KEY=<your-anthropic-key>
DASHSCOPE_API_KEY=<your-qwen-key>

# ── Oracle (stub — training data only, never written to, not in live pipeline) ─
ORACLE_DSN=<host>:<port>/<service>
ORACLE_USER=<user>
ORACLE_PASSWORD=<password>

# ── Optional ─────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
MAX_UPLOAD_SIZE_MB=20

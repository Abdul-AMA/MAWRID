# syntax=docker/dockerfile:1
FROM python:3.11-slim

RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libfontconfig1 \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ── Layer 1: heavy ML deps — only re-downloads when these versions change ─────
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --timeout 600 --retries 5 \
        torch==2.3.1 \
        torchvision \
        paddlepaddle==2.6.2 \
        paddleocr==2.7.3 \
        easyocr==1.7.2 \
        transformers==4.41.2 \
        sentencepiece==0.2.0

# ── Layer 2: everything else ──────────────────────────────────────────────────
COPY requirements-api.txt requirements-worker.txt ./
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements-worker.txt

# Models (PaddleOCR + EasyOCR) are NOT baked in — they live in named volumes
# (paddleocr_models, easyocr_models) and download once on first container start.

# ── App code ──────────────────────────────────────────────────────────────────
COPY . .
